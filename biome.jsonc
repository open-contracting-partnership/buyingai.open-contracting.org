{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 119
  },
  "files": {
    // Chapters copied from Google Docs, whose Markdown syntax the renderers rely on. Images, displayed with img.
    "includes": ["**", "!content", "!**/*.svg"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/app/globals.css"],
      "linter": {
        "rules": {
          "complexity": {
            // Overrides Tailwind and Typography styles, and screen styles in print.
            "noImportantStyles": "off"
          },
          "style": {
            // Orders rules by component, not by specificity.
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ChapterContent.tsx", "src/components/CustomTable.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            // Server components, rendered once at build time, never reconcile their lists.
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ChapterContent.tsx"],
      "linter": {
        "rules": {
          "performance": {
            // The static export can't optimize images, and Markdown images have no dimensions.
            "noImgElement": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ChapterLayout.tsx",
        "src/components/GlossaryProvider.tsx",
        "src/hooks/useIntersectionObserver.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                // Effects re-run when the chapter or content changes.
                "reportUnnecessaryDependencies": false
              }
            }
          }
        }
      }
    }
  ]
}
