{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 119
  },
  "files": {
    "includes": [
      "**",
      // Chapters copied from Google Docs. The site's renderers rely on their Markdown syntax (like * for italics).
      "!content",
      // Images displayed with img elements, which set alternative text.
      "!**/*.svg"
    ]
  },
  "linter": {
    "rules": {
      // Otherwise, configuring a rule disables the rules of domains, like React.
      "preset": "recommended",
      "complexity": {
        // The stylesheet overrides Tailwind and Typography styles, and print styles override screen styles.
        "noImportantStyles": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // Some effects re-run on purpose when the chapter or content changes.
            "reportUnnecessaryDependencies": false
          }
        }
      },
      "style": {
        // The stylesheet orders rules by component, not by specificity.
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        // The lists are rendered from static content, which is never reordered.
        "noArrayIndexKey": "off"
      }
    }
  },
  "css": {
    "parser": {
      // Tailwind's @plugin and @theme directives.
      "tailwindDirectives": true
    }
  }
}
